{
  "name": "ryurihime-blog",
  "version": "1.0.0",
  "private": true,
  "description": "RyuriHime 的个人站",
  "scripts": {
    "clean": "hexo clean",
    "assets:private": "python tools/prepare_private_assets.py && python tools/obfuscate_wallpaper.py",
    "prebuild": "python tools/prepare_private_assets.py && python tools/obfuscate_wallpaper.py",
    "build": "hexo generate",
    "postbuild": "node tools/prune_private_assets.js",
    "admin": "python tools/admin.py",
    "preview": "python -m http.server 4000 --bind 127.0.0.1 --directory public",
    "predev": "python tools/prepare_private_assets.py && python tools/obfuscate_wallpaper.py",
    "server": "hexo server",
    "dev": "hexo server"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-theme-butterfly": "^5.7.2",
    "hexo-wordcount": "^6.0.1"
  },
  "devDependencies": {
    "vditor": "3.11.3"
  }
}
